# Shopify Storefront API (headless commerce)
# These are exposed to the browser by Vite (VITE_ prefix). The Storefront token
# is a PUBLIC token scoped to read products + manage carts — safe client-side.
# Set the same two vars in Vercel (Project Settings -> Environment Variables).
VITE_SHOPIFY_DOMAIN=hmc1ej-ga.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=

# Existing email capture (api/subscribe.js -> Mailchimp)
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
