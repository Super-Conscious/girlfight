{
  "name": "girl-fight",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy:staging": "vercel deploy --scope jordan-rushs-projects 2>&1 | tee /tmp/gf-deploy.log; grep -oE 'https://girl-fight-[a-z0-9]+-jordan-rushs-projects\\.vercel\\.app' /tmp/gf-deploy.log | tail -1 | xargs -I{} vercel alias set {} girl-fight-staging.vercel.app --scope jordan-rushs-projects",
    "deploy:prod": "vercel --prod --scope jordan-rushs-projects"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "vite": "^8.0.10"
  }
}
